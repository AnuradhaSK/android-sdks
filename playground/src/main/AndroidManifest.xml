<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Lets the biometric check report whether the device can authenticate. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Lets the Custom Tabs check find a browser that implements the Custom Tabs service. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="ThunderID Playground"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Playground">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The sign-in redirect URI. The Custom Tab runs in this app's task, so singleTask
                 clears the tab and delivers the callback to the running Activity's onNewIntent. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${redirectScheme}" />
            </intent-filter>
        </activity>

    </application>

</manifest>
